# label_viewer · AWS 개발 서버 설정
# 사용: cp deploy/aws/.env.aws.example deploy/aws/.env.aws 후 값 확인 (.env.aws 는 커밋하지 않는다)
# 서버는 harness-v2 개발 서버(RHEL 9, docker·compose 설치됨)를 같이 쓴다.

# --- 접속 대상 (harness-v2/deploy/aws/.env.aws 와 같은 서버·키) ---
SSH_HOST=ec2-15-165-29-178.ap-northeast-2.compute.amazonaws.com
SSH_USER=ec2-user
SSH_KEY=~/.ssh/harness-dev.pem
# 루트 디스크가 작아(8.8GB) 데이터 디스크에 둔다.
REMOTE_ROOT=/mnt/data/label-viewer

# --- 컨테이너 (docker-compose.yml 이 읽는다) ---
# 127.0.0.1 = 루프백 전용, 접근은 tunnel.sh 로만(권장). 앱에 인증이 없으므로 0.0.0.0 으로 열지 않는다.
LABEL_VIEWER_BIND=127.0.0.1
LABEL_VIEWER_PORT=8765
LABEL_VIEWER_MAX_UPLOAD_MB=2048

# --- 로컬 터널 포트 ---
TUNNEL_PORT=18765
